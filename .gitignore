.env
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
!frontend/dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
data/*
!data/fixtures/
!data/fixtures/README.md
!data/founders/
# Clés privées founders (SENSIBLE - ne jamais commit)
data/founders/founders_wallets.json
data/founders/founders_wallets_v2.json
data/founders/*.key
data/founders/*_private.json
*.pdf
!data/fixtures/wailly_le_roi_de_l_inconnu.pdf
*.faiss
*.key
# Simulation runtime data (chain keys, local ledgers)
simulations/**/data/
simulations/**/work/
src/c/*.so
src/c/test_chain
frontend/node_modules/
.venv/
venv/

# Dossier confidentiel — JAMAIS pousser sur GitHub
confidentiel/
.env.backup*
docs/confidential/
api_key_ionos.json
.gitignore_local
data_local/

# Staging local des nœuds (jamais git)
.artcb/nodes/
**/.artcb/nodes/

# ── Logs de démarrage et d'exécution — chaque nœud génère ses propres fichiers ──
# Les logs startup shell (startup_TIMESTAMP_PID.log) sont spécifiques à chaque
# instance et ne doivent pas être committés — ils polluent le repo et créent
# des conflits entre N1, N2 et la machine de dev locale (rapport 117).
# Les logs applicatifs JSON sont nommés YYYYMMDD_artcb_startup_<node_suffix>.json
# et sont ignorés : chaque nœud tient son propre historique local.
logs/startup_*.log
logs/*_artcb_startup_*.json
logs/*_artcb_api.json
# Exception : preuves de validation P2P et benchmarks
!logs/test_replit_p2p_*.json
!logs/bench_artcb_*.json
!logs/e2e_*.json
!logs/validate_two_nodes_*.json
!logs/.gitkeep

# .node_config — fichier local persistant l'adresse wallet après /setup/init-node
# Ne jamais committer — contient l'identité de ce nœud spécifique
.node_config

# AWS node 3 private key (public key may be in deploy/)
**/artcb_aws_node_3
**/.ssh/artcb_aws_node_3
**/artcb_ovh_node_2
**/.ssh/artcb_ovh_node_2
