# ── ARTCB Network — Nouveau dépôt et domaine (rapport 116) ──────────────────
# Dépôt GitHub : https://github.com/vgactech/artcb
# Domaine officiel : artcb.space
# Bootstrap N1 : https://n1.artcb.space (→ lvx--supermicro20238.replit.app)
# Bootstrap N2 : https://n2.artcb.space (→ lvx--supermicro20239.replit.app)

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  OBLIGATOIRE — le nœud refuse de démarrer sans cette variable (rapport 117)
# Créer un wallet d'abord : POST /api/v1/wallet/create {"name": "mon_noeud"}
# Puis renseigner l'adresse retournée ici.
# Sans ARTCB_NODE_WALLET_ADDRESS, aucun node_id aléatoire n'est généré :
# le nœud s'arrête avec un message d'erreur explicite.
# ─────────────────────────────────────────────────────────────────────────────
ARTCB_NODE_WALLET_ADDRESS=artcb1_REMPLACER_PAR_VOTRE_ADRESSE
ARTCB_NODE_PUBLIC_URL=https://votre-noeud.artcb.space

# Anti-fraude — 1 wallet par machine (true pour tests/dev)
ARTCB_ALLOW_MULTI_WALLET=false
ARTCB_BOOTSTRAP_NODE=false

# ── IONOS DNS API ─────────────────────────────────────────────────────────────
# Format : publicprefix.secret (JAMAIS committer la valeur réelle)
# Générer sur : https://developer.hosting.ionos.com/keys
# IONOS_API_KEY=VOTRE_PREFIX.VOTRE_SECRET
# Login customer (email) — absent des coffres Doppler/Cursor au 2026-09-02
# (rapport 197). Ne pas committer la valeur réelle.
# IONOS_EMAIL=



# ── Anti-Sybil — configuration dynamique ──────────────────────────────
# Intervalle minimum entre 2 blocs du même wallet (défaut: 60s)
ARTCB_MIN_BLOCK_INTERVAL_SEC=60
# Bypass rate-limit pour blocs IA (ai_memo/ai_think) — true=étude, false=prod
ARTCB_ANTI_SYBIL_AI_BYPASS=false
# Mode étude global — rien rejeté pour rate-limit (PoL min + blacklist actifs)
ARTCB_ANTI_SYBIL_STUDY_MODE=false

# ── WatsonX IBM — paramètres requis ───────────────────────────────────
# IAM fonctionne ; project_id requis pour les requêtes LLM
# WATSONX_API_KEY=
# WATSONX_URL=https://eu-de.ml.cloud.ibm.com
# WATSONX_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Bridges blockchain — interopérabilité Phase 12.2 ──────────────────
#
# À QUOI SERVENT INFURA ET ALCHEMY ?
# ─────────────────────────────────────────────────────────────────────
# Un nœud Ethereum complet = ~1 To de données + mois de synchronisation.
# Infura et Alchemy fournissent des nœuds déjà synchronisés accessibles
# via une simple URL HTTPS. ARTCB les utilise UNIQUEMENT en lecture seule
# pour récupérer les données d'une transaction externe, les encoder en
# IR PoL, puis les graver dans la blockchain ARTCB.
# Ils ne stockent rien dans ARTCB. C'est juste un accès en lecture.
#
# Infura  : https://infura.io — gratuit, 100K req/jour
#   Clé   : Project ID dans ton tableau de bord
#   URL   : https://mainnet.infura.io/v3/TON_PROJECT_ID
#
# Alchemy : https://alchemy.com — gratuit, 300M compute units/mois
#   Clé   : API Key dans Dashboard → Apps
#   URL   : https://eth-mainnet.g.alchemy.com/v2/TON_API_KEY
#
# Bitcoin : GRATUIT, aucune clé requise (mempool.space)
BITCOIN_API_URL=https://mempool.space/api
#
# Ethereum : utiliser Alchemy (recommandé) ou Infura — testé et validé ✅
# ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/TON_API_KEY_ALCHEMY
# ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/TON_PROJECT_ID_INFURA
ETHEREUM_RPC_URL=https://cloudflare-eth.com
#
# BNB Chain : endpoint public gratuit, pas de clé — testé ✅
BNB_RPC_URL=https://bsc.publicnode.com
#
# Polygon : endpoint publicnode — corrigé (polygon-rpc.com → 401) — testé ✅
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
#
# Avalanche C-Chain : endpoint officiel gratuit — testé ✅
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
#
# Solana : endpoint public gratuit — testé ✅
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
#
# ── Kaggle — datasets pour pipeline minage PoL ───────────────────────────
# Obtenir la clé : https://www.kaggle.com/settings → API → Create New Token
# Télécharger kaggle.json OU définir ces variables
# KAGGLE_USERNAME=ndarray2000
# KAGGLE_KEY=VOTRE_CLE_API_KAGGLE

# ── IP publique de ce nœud ARTCB ──────────────────────────────────────────
# IP publique de ce nœud ARTCB (pour le gossip P2P multi-nœuds)
# Sans cette variable, le nœud s'annonce comme 127.0.0.1 (inaccessible depuis l'extérieur)
# ARTCB_PUBLIC_HOST=51.255.22.253
#
# URL Ollama si installé sur une machine distante
# ARTCB_OLLAMA_URL=http://192.168.1.10:11434
