run = "bash scripts/replit_start.sh"
language = "python3"
entrypoint = "src/api/main.py"
modules = ["python-3.11", "nodejs-20", "bash", "web"]

[nix]
channel = "stable-25_05"

[env]
PYTHONPATH = "/home/runner/${REPL_SLUG}"
ARTCB_DEBUG = "true"
ARTCB_DATA_DIR = "/home/runner/${REPL_SLUG}/data"
ARTCB_LOG_DIR = "/home/runner/${REPL_SLUG}/logs"
ARTCB_ENCODE_MODE = "rule-based"
ARTCB_LLM_ENABLED = "false"
# ARTCB_ANTI_SYBIL_AI_BYPASS dev=true / prod=false
# En mode interactif (dev) : bypass actif pour faciliter les tests
# En déploiement Autoscale (prod) : doit être false — définir dans les secrets Replit
ARTCB_ANTI_SYBIL_AI_BYPASS = "false"
ARTCB_REPLIT_BRANCH = "cursor/replit-sync-ready-16d8"
ARTCB_NODE_ID = "replit-node-1"
# Architecture A: set ARTCB_REPLIT_PIN_SHA in Replit Secrets to the
# operator-approved commit (full or 12+ hex). Empty = fetch only, no reset --hard.

[deployment]
# Uses the same validated startup script as the interactive workflow
run = ["bash", "scripts/replit_start.sh"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 19100
externalPort = 3000

[[ports]]
localPort = 19200
externalPort = 3001

[[ports]]
localPort = 19201
externalPort = 3002

[[ports]]
localPort = 19300
externalPort = 3003

[[ports]]
localPort = 19301
externalPort = 4200

[[ports]]
localPort = 19400
externalPort = 5000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit_start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
