run = "bash scripts/replit_autoscale.sh"
language = "python3"
entrypoint = "src/api/main.py"
modules = ["python-3.11", "nodejs-20", "bash", "web"]

[nix]
channel = "stable-25_05"
# Runtime API + outils nécessaires aux builds explicites. liboqs n'est pas
# ajouté ici : sa compilation reste optionnelle et hors du chemin de boot.
packages = ["bash", "cargo", "cmake", "curl", "gcc", "git", "libiconv", "libsodium", "libxcrypt", "libyaml", "ninja", "openssl", "pkg-config", "rustc", "tesseract"]

[env]
PYTHONPATH = "/home/runner/${REPL_SLUG}"
ARTCB_DEBUG = "true"
ARTCB_DATA_DIR = "/home/runner/${REPL_SLUG}/data"
ARTCB_LOG_DIR = "/home/runner/${REPL_SLUG}/logs"
ARTCB_ENCODE_MODE = "rule-based"
ARTCB_LLM_ENABLED = "false"
# ARTCB_ANTI_SYBIL_AI_BYPASS dev=true / prod=false
# En déploiement Autoscale, conserver false.
ARTCB_ANTI_SYBIL_AI_BYPASS = "false"
# Ne jamais compiler liboqs dans le chemin critique Autoscale.
ARTCB_INSTALL_PQC = "0"
ARTCB_REPLIT_SNAPSHOT_ONLY = "1"
ARTCB_PQC_TIMEOUT = "300"
ARTCB_REPLIT_BRANCH = "main"
ARTCB_NODE_ID = "replit-node-1"
# Architecture A : fournir ARTCB_REPLIT_PIN_SHA dans Replit Secrets.
# Ne jamais mettre le SHA ou un secret sensible en clair dans ce fichier.

[deployment]
run = ["bash", "scripts/replit_autoscale.sh"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit_autoscale.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
