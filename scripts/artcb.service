[Unit]
Description=ARTCB Node API (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/artcb
# Token Doppler (optionnel, root-only 600) : DOPPLER_TOKEN=dp.st.xxx
# Si présent, start_node.sh injecte les secrets via `doppler run`
# et aucun .env n'est nécessaire sur le serveur.
EnvironmentFile=-/etc/artcb/doppler.env
EnvironmentFile=-/etc/artcb/release.env
ExecStart=/home/ubuntu/artcb/scripts/start_node.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
